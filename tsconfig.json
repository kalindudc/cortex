{
  "include": ["src/**/*", "test/**/*", "scripts/**/*.ts", "index.ts"],
  "exclude": ["node_modules", "bin", "tmp", "src/extensions/**"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["@types/bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
